# Copy to server/.env (npm scripts load it automatically).
DATABASE_URL=postgres://loopa:loopa@localhost:5432/loopa
PORT=4000
HOST=0.0.0.0
# Folder with the sample clips (relative to server/). Filled by `npm run media`.
SEED_MEDIA_DIR=../media
# Where uploaded videos and avatars are stored (relative to server/).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Set when the API sits behind a public URL (tunnel, server); otherwise links use the request host.
PUBLIC_BASE_URL=
# Enables POST /api/auth/dev-login («Войти как демо»). Must be false on any public server.
DEV_AUTH=true
LOG_LEVEL=info
